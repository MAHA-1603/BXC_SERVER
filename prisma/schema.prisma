// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  fullName       String
  email          String     @unique
  password       String
  companyName    String
  profilePicture String?
  role           Role       @default(ADMIN)
  adminRole      AdminRole  @default(MANAGER)
  permissions    String[]   @default([])
  status         UserStatus @default(APPROVED)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())

  DealLifecycle DealLifecycle[]

  escalationConversations EscalationConversation[] @relation("AdminInEscalations")
  SupportQuery            SupportQuery[]
  blogs                   Blog[]                   @relation("AdminBlogs")
  LoginOTP                LoginOTP[]

  @@index([status])
  @@index([role])
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  CUSTOMER_SUPPORT
  FINANCE
  BLOG_MANAGER
}

model Blog {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String  @unique
  content       String
  summary       String?
  featuredImage String?
  authorName    String
  isPublished   Boolean @default(false)

  // SEO Metadata
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[] @default([])

  tags       String[] @default([])
  categories String[] @default([])

  authorId    String? @db.ObjectId
  authorAdmin Admin?  @relation("AdminBlogs", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([isPublished])
}

model User {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  // User details
  fullName       String
  email          String  @unique
  password       String
  profilePicture String?
  websiteUrl     String?

  // Company details (flattened into same table)
  companyName         String?
  gstNumber           String?
  gstDocumentUrl      String? // URL provided by frontend
  panNumber           String?
  panDocumentUrl      String?
  cinNumber           String?
  cinDocumentUrl      String?
  typeOfEntity        String?
  dateOfIncorporation DateTime?
  industryFocus       String?
  registeredAddress   String?
  businessAddress     String?
  state               String?
  city                String?
  pincode             String?

  // JSON fields for multiple contacts
  contactInfo Json?

  // Workflow
  role                        Role @default(USER)
  combinedJobsRemaining       Int  @default(0)
  combinedUrgentJobsRemaining Int  @default(0)
  combinedBoostsRemaining     Int  @default(0)
  combinedRefreshesRemaining  Int  @default(0)
  combinedProfilesRemaining   Int  @default(0)
  combinedTotalJobsUsed       Int  @default(0)
  combinedTotalProfilesUsed   Int  @default(0)

  isVerified         Boolean            @default(false)
  isVerifiedCompany  Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  country            String?
  onboardedAt        DateTime?          @default(now())

  isPriorityUser  Boolean     @default(false)
  status          UserStatus  @default(PENDING)
  previousStatus  UserStatus? // Stores status before suspension for restoration
  rejectionReason String      @default("")
  mode            Mode        @default(SEEKER) // PROVIDER or SEEKER
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  trialEndsAt     DateTime?
  trialPostsUsed  Int         @default(0)

  // ── E2EE key pair (RSA-2048) ─────────────────────────────────────────────
  publicKey  String? // PEM-encoded RSA-2048 public key (shared openly)
  privateKey String? // PEM-encoded RSA-2048 private key (server-managed, never exposed to clients)

  ResetToken ResetToken[]
  LoginOTP   LoginOTP[]

  ProviderPost ProviderPost[]

  SeekerPost SeekerPost[]

  Application Application[]

  Message Message[]

  Notification Notification[]

  Payment Payment[]

  Subscription Subscription[]

  AddOnPurchase AddOnPurchase[]

  Transaction Transaction[]

  escalationConversations EscalationConversation[] @relation("EscalatedBy")
  SupportQuery            SupportQuery[]
  DeviceToken             DeviceToken[]

  @@index([status])
  @@index([role])
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELLED
  EXPIRED
  FAILED
}

enum PaymentStatus {
  CAPTURED
  FAILED
  REFUNDED
}

